# Point Of Care Connectivity Agent - Environment Configuration
# Copy this file to .env and adjust values for your environment

# HMAC-SHA256 Audit Trail Secret Key
# IMPORTANT: Set a strong, unique key in production to ensure audit trail integrity
# If not set, a random key will be generated at startup (not suitable for production)
AUDIT_SECRET_KEY=your-secure-audit-key-here

# LLM Provider (mock, ollama, claude, openai)
MODEL_PROVIDER=mock

# Server Configuration
HOST=127.0.0.1
PORT=8000
