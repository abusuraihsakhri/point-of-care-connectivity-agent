{
  "openapi": "3.1.0",
  "info": {
    "title": "Point of Care Connectivity Agent API",
    "description": "Local demonstration endpoints for synthetic measurements; illustrative rules only, not validated for clinical use.",
    "version": "3.0.0-ENTERPRISE",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Serve local operations console",
        "responses": {
          "200": {
            "description": "HTML operations console"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Get in-memory JSON counters and audit-chain verification",
        "responses": {
          "200": {
            "description": "JSON operational metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Illustrative consensus dossier and HMAC hash"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic local mock response",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Get in-memory audit snapshots and cryptographic integrity result",
        "responses": {
          "200": {
            "description": "Ephemeral audit entries and integrity status"
          }
        }
      }
    },
    "/metrics/prometheus": {
      "get": {
        "summary": "Get Prometheus-format task counters",
        "responses": {
          "200": {
            "description": "Prometheus text exposition format"
          }
        }
      }
    }
  }
}
